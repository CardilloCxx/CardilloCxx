material {
    name : "PBR_VertexColor",
    shadingModel : lit,
    culling : back,
    quality : high,

    parameters : [
        { type : float4, name : "albedo" },            // x: r, y: g, z: b, w: a

        { type : float, name : "metallic" },
        { type : float, name : "roughness" },
        { type : float, name : "clearCoat" },
        { type : float, name : "clearCoatRoughness" },
        { type : float, name : "reflectance" },
        { type : float, name : "specular" },
        { type : float, name : "sheen" },
        { type : float, name : "sheenRoughness" },
        { type : float, name : "ambientOcclusion" },
        { type : float, name: "anisotropy" },

        { type : float4, name : "uvCoordScale" },      // xy: offset, zw: scale
        
        { type : float4, name : "textureSwitches" },   // x: albedo, y: normal, z: roughness, w: metallic
        { type : float, name : "textureSwitches2" },  // x: ao
        
        { type : sampler2d, name : "albedoMap" },
        { type : sampler2d, name : "normalMap" },
        { type : sampler2d, name : "roughnessMap" },
        { type : sampler2d, name : "metallicMap" },
        { type : sampler2d, name : "aoMap" },

        { type : float3, name : "velocity" },       // x: velocityX, y: velocityY, z: velocityZ
        { type : float3, name : "angularVelocity" } // x: angularVelocityX, y: angularVelocityY, z: angularVelocityZ
    ],
    requires : [
        tangents,
        uv0
    ],
    variables : [
        vertexVelocity
    ]
}

vertex {
    void materialVertex(inout MaterialVertexInputs material) {
        mat3 worldFromModel = mat3(getWorldFromModelMatrix());

        mat3 rotationOnly = mat3(
            normalize(worldFromModel[0]),
            normalize(worldFromModel[1]),
            normalize(worldFromModel[2])
        );

        vec3 angularVelInertial = rotationOnly * materialParams.angularVelocity;
        vec3 localPosInertial = worldFromModel * getPosition().xyz;
        vec3 totalVelocityInertial = materialParams.velocity + cross(angularVelInertial, localPosInertial);

        material.vertexVelocity.xyz = totalVelocityInertial;
    }
}

fragment {

    vec3 viridis(float t) {
        t = clamp(t, 0.0, 1.0);
        const vec3 c0 = vec3(0.2777273272234177, 0.005407344544966578, 0.3340998053353061);
        const vec3 c1 = vec3(0.1050930431085774, 1.404613529898575, 1.384590162594685);
        const vec3 c2 = vec3(-0.3308618287255563, 0.214847559468213, 0.09509516302823659);
        const vec3 c3 = vec3(-4.634230498983486, -5.799100973351585, -19.33244095627987);
        const vec3 c4 = vec3(6.228269936347081, 14.17993336680509, 56.69055260068105);
        const vec3 c5 = vec3(4.776384997670288, -13.74514537774601, -65.35303263337234);
        const vec3 c6 = vec3(-5.435455855934631, 4.645852612178535, 26.3124352495832);

        return c0+t*(c1+t*(c2+t*(c3+t*(c4+t*(c5+t*c6)))));
    }

    vec3 magma(float t) {
        t = clamp(t, 0.0, 1.0);
        const vec3 c0 = vec3(-0.002136485053939582, -0.000749655052795221, -0.005386127855323933);
        const vec3 c1 = vec3(0.2516605407371642, 0.6775232436837668, 2.494026599312351);
        const vec3 c2 = vec3(8.353717279216625, -3.577719514958484, 0.3144679030132573);
        const vec3 c3 = vec3(-27.66873308576866, 14.26473078096533, -13.64921318813922);
        const vec3 c4 = vec3(52.17613981234068, -27.94360607168351, 12.94416944238394);
        const vec3 c5 = vec3(-50.76852536473588, 29.04658282127291, 4.23415299384598);
        const vec3 c6 = vec3(18.65570506591883, -11.48977351997711, -5.601961508734096);

        return c0+t*(c1+t*(c2+t*(c3+t*(c4+t*(c5+t*c6)))));
    }

    void material(inout MaterialInputs inputs) {

        vec2 uv = getUV0() * materialParams.uvCoordScale.zw + materialParams.uvCoordScale.xy;

        if (materialParams.textureSwitches.y > 0.5) {
            vec3 normalMap = texture(materialParams_normalMap, uv).rgb;
            inputs.normal = normalize(normalMap * 2.0 - 1.0);
        }
        
        prepareMaterial(inputs);

        if (materialParams.textureSwitches.x > 0.5) {
            vec4 linearColor = texture(materialParams_albedoMap, uv);
            inputs.baseColor.rgb = linearColor.rgb; //pow(linearColor.rgb, vec3(1.0 / 2.2));
        } else {
            inputs.baseColor = materialParams.albedo;
            
            float mixFactor = clamp(length(materialParams.velocity.xyz) * 10.0, 0.0, 1.0);
            inputs.baseColor.rgb = mix(inputs.baseColor.rgb, magma(length(variable_vertexVelocity.xyz)), mixFactor);
        }

        if (materialParams.textureSwitches.z > 0.5) {
            float roughnessValue = texture(materialParams_roughnessMap, uv).r;
            inputs.roughness = roughnessValue;
        } else {
            inputs.roughness = materialParams.roughness;
        }

        if (materialParams.textureSwitches.w > 0.5) {
            float metallicValue = texture(materialParams_metallicMap, uv).r;
            inputs.metallic = metallicValue;
        } else {
            inputs.metallic = materialParams.metallic;
        }

        if (materialParams.textureSwitches2 > 0.5) {
            float aoValue = texture(materialParams_aoMap, uv).r;
            inputs.ambientOcclusion = aoValue;
        } else {
            inputs.ambientOcclusion = materialParams.ambientOcclusion;
        }

        // inputs.roughness = 0.0;
        // inputs.specularFactor = materialParams.specular;
        // inputs.sheenRoughness = materialParams.sheen;
        inputs.reflectance = materialParams.reflectance;
        inputs.clearCoat = materialParams.clearCoat;
        inputs.clearCoatRoughness = materialParams.clearCoatRoughness;

        if (materialParams.anisotropy > 0.0) {
            inputs.anisotropy = materialParams.anisotropy;
        }
    }
}