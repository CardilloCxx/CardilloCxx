scene.name=conveyor_merge

# Infeed-merge transfer with waterfall, see ConveyorMergeScene.hpp.
# Scene parameters: waterfall height 0, 0.01 or 0.05 m in the experiments.
# scene.waterfall_height=0.001 # exact 0 is not possible with sharp corners
# scene.waterfall_height=0.01
scene.waterfall_height=0.05
scene.merge_speed=2.2
scene.infeed_scale=0.98
scene.angle_deg=30
scene.start_distance=0.2

sim.T=3.0
sim.dt=5e-3          # 200 Hz, as in the Isaac Sim reference model
sim.gravity=0 0 -9.81

friction.enable=on
friction.combine=min
friction.default_mu=0.32
restitution.default_normal=0
restitution.default_tangential=0

collision.broadphase=dynamic_aabb
collision.security_margin=0.0
collision.use_patch_vertices=true
collision.max_patches=8
collision.min_pair_contact_distance=0.001

solver.name=moreau
solver.type=projected_jacobi
solver.type=condensed
moreau.theta=0.5
pj.max_iterations=10000
pj.tol_abs=1e-6
pj.tol_rel=1e-6
pj.nesterov=true
pj.warmstart=true

output.interval_steps=1
output.folder=./vtk_out
output.filename_prefix=conveyor_merge
