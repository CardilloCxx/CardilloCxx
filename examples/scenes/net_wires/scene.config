scene.name = net_wires

###############################################
# Simulation settings
###############################################
sim.T=0.5          # total simulation time (seconds): impact (block starts just above the net)
sim.dt=1e-4        # time step (seconds), as in Eberhardt et al. 2026; contacts close ~ v h = 0.4 mm deep at 7.67 m/s
sim.gravity=0 0 -9.81  # gravity vector gx gy gz; the net lies in the x-y plane

###############################################
# Friction settings
###############################################
friction.enable=on
friction.combine=geom         # min | arith | geom
friction.default_mu=0.2       # steel on steel (wires, clips, shackles), assumed; also block on steel

###############################################
# Output settings
###############################################
output.interval_steps=10                 # write VTK every N steps (0.01 s); a frame of the full net is large
output.folder = ./vtk_out                # output directory path
output.filename_prefix = net_wires       # prefix for output files

###############################################
# Scene settings (defaults and references: NetWiresScene.hpp, WireRing.hpp, RockfallTest.hpp)
###############################################
# Net and mounting
scene.rings_x=10                         # rings per long row (short rows have one less)
scene.rings_y=10                         # number of long rows: 10 x 10 + 9 x 9 = 181 rings
scene.net_size_x=3.9                     # outer net dimensions (m), Grassl 2002
scene.net_size_y=3.9
scene.crossing_clearance=1.5             # initial gap of linked rings at the crossings (bundle diameters)
scene.string_length=0.1                  # shackle strings to the frame (m, N/m, Ns/m)
scene.string_stiffness=1e7
scene.string_damping=0
scene.shackle_mode=1                     # 0: a string from every wire, 1: rigid shackle (torus) around the bundle
scene.shackle_diameter=0.012             # steel section of the shackle (m)
scene.shackle_gap=0.003
scene.shackle_resolution=24              # torus mesh facets around the shackle

# Rings: 9 windings of a 3 mm wire, 300 mm inner diameter
scene.ring_wire=1                        # 0: one closed loop per winding, 1: one wire wound 9 times, ends overlapping at the first clip
scene.ring_windings=9
scene.wire_diameter=0.003
scene.ring_inner_diameter=0.3
scene.wire_gap=1e-4                      # initial gap between the wires (passes) of a bundle (m)
scene.wire_segments=64                   # beam elements per turn
scene.wire_overhang=0.03                 # each end of the wound wire extends this far past the first clip (m), whole elements
scene.primitive_colliders=0              # 1: capsule per wire segment, 0: inter-segment hull colliders

# Clips
scene.clip_mode=3                        # 0: none, 1: pinned, 2: rigid, 3: pre-tensioned band
scene.clip_count=3
scene.clip_offset_deg=15                 # clips at 15°, 135°, 255°: clear of the shackles at 0°, 90°, 180°, 270°
scene.band_thickness=0.0015              # steel of the clips: sleeve wall (clip_mode 1, 2) or band (3)
scene.band_width=0.015                   # length of a sleeve, width of a band
scene.band_segments=12
scene.band_pretension=1e-3               # relative shortening of the band's rest length

# Block and debris
scene.block_mass=850                     # non-convex rock with mass and inertia of the EOTA block
scene.block_reference_density=2700       # EOTA block density, 2500-3000 kg/m^3 (ETAG 027)
scene.block_mesh=0                       # 0: rock.obj, 1: rock2.obj
scene.drop_height=3                      # fall height (m)
scene.start_gap=0.02                     # start this far above the net, with the velocity of the fall from drop_height
scene.extra_boulders=25                  # additional small rocks falling with the block
scene.extra_size_min=0.45
scene.extra_size_max=0.8
scene.extra_density=2700
scene.extra_spread=4
scene.extra_seed=1

###############################################
# Collision settings
###############################################
collision.broadphase=dynamic_aabb
collision.match_max_dist=0.002              # wires are 3 mm thick: match contacts within this distance (m)
collision.security_margin=0.0000
collision.max_raw_contacts=1000000
collision.max_patches=4
collision.use_patch_vertices=true
collision.min_pair_contact_distance=0.0005  # dedupe contacts of a pair closer than this (m)

###############################################
# Solver settings
###############################################
moreau.theta=1.0
moreau.implicit_gyroscopy=false

solver.name=moreau
solver.type=condensed
# solver.type=pj
# solver.type=clarabel
solver.verbosity=0

pj.max_iterations=500000
pj.tol_abs=1e-3
pj.tol_rel=1e-3
pj.relaxation=1.0
pj.alpha=1.0
# pj.alpha=0.5
pj.nesterov=true
pj.nesterov_beta_threshold=1.0
pj.nesterov_restart_limit=10000
pj.warmstart=true

condensed.sweep_mode=colored          # gauss_seidel | colored
condensed.local_solve=projection      # projection | newton
condensed.num_threads=8               # one thread on the shared machine (CLAUDE.md)
condensed.newton_max_iters=8
condensed.newton_tol=1e-10
condensed.projection_rho_strategy=split
condensed.true_schur=true
