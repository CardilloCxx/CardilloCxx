scene.name = rock_cluster

###############################################
# Simulation settings
###############################################
sim.T=1.5
sim.dt=1e-4
sim.gravity=0 0 -9.81

###############################################
# Friction settings
###############################################
friction.enable=on
friction.combine=geom
friction.default_mu=0.5

###############################################
# Output settings
###############################################
output.interval_steps=50
output.write_contacts=true
output.folder = ./vtk_out_rock_cluster
output.filename_prefix = rock_cluster

###############################################
# Collision settings
###############################################
collision.broadphase=dynamic_aabb
collision.match_max_dist=0.02
collision.security_margin=0.0
collision.max_raw_contacts=100000
collision.max_patches=4
collision.use_patch_vertices=true
collision.min_pair_contact_distance=0.002

###############################################
# Shared iterative-solver knobs
###############################################
pj.max_iterations=200000
pj.tol_abs=1e-8
pj.tol_rel=1e-8
pj.relaxation=1.0
pj.alpha=0.3
pj.nesterov=true
pj.warmstart=true

###############################################
# Solver settings
###############################################
solver.name=moreau
moreau.theta=0.5
moreau.implicit_gyroscopy=false
solver.type=projected_jacobi
# With constraint_bias_factor > 0 the rigid bond's position feedback grows exponentially at
# sim.dt=1e-4 (|Lambda| rises from 1e-17 to O(1) during free fall, ~1e11 per 250 steps) and
# triggers the breaking criterion before the impact
constraint_bias_factor=0.0

###############################################
# Debug settings
###############################################
debug.pj=false
debug.rb=false
debug.mesh=false
