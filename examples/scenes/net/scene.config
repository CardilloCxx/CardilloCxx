scene.name = net

###############################################
# Simulation settings
###############################################
sim.T=0.5          # total simulation time (seconds): impact (block starts just above the net)
sim.dt=2.5e-4      # time step (seconds), 5e-5 in Eberhardt et al. 2026
sim.gravity=0 0 -9.81  # gravity vector gx gy gz (space- or comma-separated). The net lies in the x-y plane.

###############################################
# Friction settings
###############################################
friction.enable=on
friction.combine=geom         # min | arith | geom
friction.default_mu=0.1       # default friction coefficient when not set on entities

###############################################
# Output settings
###############################################
output.interval_steps=20                 # write VTK every N steps
output.folder = ./vtk_out                # output directory path
output.filename_prefix = net     #  prefix for output VTK files

###############################################
# Scene settings (defaults and references: NetScene.hpp)
###############################################
scene.primitive_colliders=0              # 1: capsule per ring segment, 0: inter-segment hull colliders
scene.rings_x=10                         # rings per long row (short rows have one less)
scene.rings_y=10                         # number of long rows: 10 x 10 + 9 x 9 = 181 rings
scene.net_size_x=3.9                     # outer net dimensions (m), Grassl 2002
scene.net_size_y=3.9
scene.ring_windings=12                   # ROCCO 12/3/300
scene.wire_diameter=0.003
scene.ring_inner_diameter=0.3
# scene.ring_segments=16
scene.ring_segments=32
scene.axial_stiffness_factor=0.2         # measured / theoretical axial ring stiffness (Grassl 2002)
scene.crossing_clearance=1.5             # initial gap of linked rings at the crossings (bundle diameters)
scene.string_length=0.1                  # shackle strings to the frame (m, N/m, Ns/m)
scene.string_stiffness=1e7
scene.string_damping=0
scene.block_mass=850                     # non-convex rock with mass and inertia of the EOTA block
scene.block_reference_density=2700       # EOTA block density, 2500-3000 kg/m^3 (ETAG 027)
scene.block_mesh=0                       # 0: rock.obj, 1: rock2.obj
scene.drop_height=3                      # fall height (m)
scene.start_gap=0.02                     # start this far above the net, with the velocity of the fall from drop_height
scene.extra_boulders=0                   # additional small rocks falling with the block
scene.extra_size_min=0.15
scene.extra_size_max=0.4
scene.extra_density=2700
scene.extra_spread=2
scene.extra_seed=1


###############################################
# Collision settings
###############################################
# collision.broadphase selects the COAL BroadPhase manager used to cull pairs.
# Available values:
#   dynamic_aabb         - DynamicAABBTreeCollisionManager
#   dynamic_aabb_array   - DynamicAABBTreeArrayCollisionManager
#   naive                - NaiveCollisionManager (O(N^2), for debugging)
#   sap                  - SaPCollisionManager (Sort and Prune)
#   ssap                 - SSaPCollisionManager (Multi-axis SaP)
collision.broadphase=dynamic_aabb
collision.match_max_dist=0.02               # maximum distance (in meters) to consider a current contact matched to a previous one (for warmstarting)
collision.security_margin=0.0000            # small positive margin improves robustness for rotating/thin mesh contacts
collision.max_raw_contacts=1000000          # per-pair raw contact cap requested from narrowphase
collision.max_patches=4                     # per-pair patch cap (only relevant when using patch vertices)
collision.use_patch_vertices=true           # when true, emit patch vertices; when false, emit raw contacts
collision.min_pair_contact_distance=0.001   # dedupe contacts within the same entity pair that are closer than this (meters); 0 disables

###############################################
# Projected Jacobi (normal contact) settings
###############################################
pj.max_iterations=500000
pj.tol_abs=1e-2
pj.tol_rel=1e-2
# conic solver
# pj.tol_abs=1e-4
# pj.tol_rel=1e-4
pj.relaxation=1.0
# pj.alpha=0.01
# pj.alpha=1.0
pj.alpha=0.9
pj.nesterov=true                   # enable Nesterov acceleration
pj.nesterov_beta_threshold=1.0     # reset momentum when beta exceeds this (0...1), higher = more aggressive
pj.nesterov_restart_limit=10000    # after this many resets in a solve, disable momentum for the remainder
pj.warmstart=true                  # enable warmstarting & caching of contact impulses across steps

###############################################
# Solver settings
###############################################
# moreau.theta=0.7
moreau.theta=1.0
moreau.implicit_gyroscopy=false

solver.name=moreau
solver.type=condensed
# solver.type=pj
# solver.type=clarabel
# solver.type=scs
# solver.type=conicxx

###############################################
# Condensed solver settings
###############################################
condensed.sweep_mode=gauss_seidel          # gauss_seidel | colored
condensed.local_solve=projection      # projection | newton
condensed.num_threads=6               # 0 = OpenMP default (all available cores)
condensed.newton_max_iters=8
condensed.newton_tol=1e-10

# condensed.projection_rho_strategy=diagonal # diagonal | split | full
condensed.projection_rho_strategy=split
# condensed.projection_rho_strategy=full
condensed.true_schur=true

###############################################
# Debug settings
###############################################
debug.pj=false
debug.rb=false

###################
# condensed results
###################
       
