###############################################
# Scene parameters
###############################################
# Isotropic ciliary walker of Mohanty et al., arXiv:2512.09840 (Fig. S1B, Fig. 4): 28 x 28 x 10 mm
# silicone body (~9 g), 5 x 5 cylindrical cilia (5 mm: diameter 1.0 mm over 3 mm, then
# 0.6 -> 0.5 mm), pitch 6 mm, 12 g top weight, f = 40 Hz, Gamma = 2.45.
# For the 10 x 10 walker of Fig. 5C / Fig. 6 use grid_n = 10, pitch = 0.003, added_weight = 0.008
# (Fig. 5C) or 0 (Fig. 6, cilia unbuckled at rest) and gamma = 1.49.
scene.walker = isotropic
scene.youngs_modulus = 1.2e6      # ED22F silicone (Table SI)
scene.poisson_ratio = 0.49
scene.density = 1120              # from the 9 g walker
scene.added_weight = 0.012        # kg
scene.frequency = 40              # Hz
scene.gamma = 2.45                # A (2 pi f)^2 / g
scene.grid_n = 5
scene.pitch = 0.006
scene.tip_offset = 1e-4           # lateral tip offset, selects the buckling direction
scene.tip_offset_angle_deg = 0    # direction of the tip offset (0 = x)
scene.cilium_segments = 10        # node at the diameter step (3 mm)
scene.n_walkers = 4               # walkers on a circle around the arena center (swarm experiments: Fig. 6)
scene.walker_placement_radius = 0.04
scene.walker_yaw_step_deg = 90    # walker k is rotated by k * 90 deg (tip offset along y for the second)

# Damping of the rod elements as a fraction of their elasticity: D = d * K (d in seconds,
# modal damping ratio zeta = d * omega / 2). Linear modes of a cilium (10 elements, clamped at
# the body, unbuckled): bending 1806 rad/s (double), 2nd bending 5490 rad/s, torsion 9786 rad/s;
# walker bouncing 342 rad/s (54 Hz). Load per cilium 8.2 mN vs. buckling load 2.7 mN (tip free)
# / 10.4 mN (tip pinned). d = 1e-4 gives zeta = 9 % at the first bending mode, 1.7 % bounce.
scene.rod_damping_factor = 1e-4

###############################################
# Simulation settings
###############################################
# sim.T=20             # total simulation time (seconds)
sim.T=5
sim.dt=1e-4           # ~45 steps per period of the first cilium bending mode, 250 per drive period

###############################################
# Friction settings
###############################################
friction.enable=on
friction.combine=geom         # min | arith | geom
# friction.default_mu=1.0       # silicone on aluminium (not given in the paper)
friction.default_mu=0.4

###############################################
# Restitution settings
###############################################
restitution.default_normal=0.0
restitution.default_tangential=0.0

###############################################
# Output settings
###############################################
output.interval_steps=10                 # write VTK every N steps
output.folder = ./vtk_out_cilia                # output directory path

###############################################
# Collision settings
###############################################
# collision.broadphase selects the COAL BroadPhase manager used to cull pairs.
# Available values:
#   dynamic_aabb         - DynamicAABBTreeCollisionManager
#   dynamic_aabb_array   - DynamicAABBTreeArrayCollisionManager
#   naive                - NaiveCollisionManager (O(N^2), for debugging)
#   sap                  - SaPCollisionManager (Sort and Prune)
#   ssap                 - SSaPCollisionManager (Multi-axis SaP)
collision.broadphase=dynamic_aabb
collision.disable_all=false
collision.match_max_dist=0.02               # maximum distance (in meters) to consider a current contact matched to a previous one (for warmstarting)
collision.security_margin=0.0000            # small positive margin improves robustness for rotating/thin mesh contacts
collision.max_raw_contacts=1000000          # per-pair raw contact cap requested from narrowphase
collision.max_patches=4                 # per-pair patch cap (only relevant when using patch vertices)
collision.use_patch_vertices=true           # when true, emit patch vertices; when false, emit raw contacts
collision.min_pair_contact_distance=0   # dedupe contacts within the same entity pair that are closer than this (meters); 0 disables

collision.patch_num_samples = 12
collision.patch_tolerance = 1e-4

###############################################
# Projected Jacobi (normal contact) settings
###############################################
pj.max_iterations=500000
pj.tol_abs=1e-4
pj.tol_rel=1e-4
# pj.alpha=0.01
pj.alpha=0.9
pj.nesterov=true                   # enable Nesterov acceleration for Projected Jacobi
pj.nesterov_beta_threshold=1.0     # reset momentum when beta exceeds this (0..1), higher = more aggressive
pj.nesterov_restart_limit=10000    # after this many resets in a solve, disable momentum for the remainder
pj.warmstart=true                  # enable warmstarting & caching of contact impulses across steps

###############################################
# Solver settings
###############################################
moreau.theta=0.6
moreau.implicit_gyroscopy=false
# solver.type=conicxx
solver.type=condensed

################################################
# condensed settings
################################################
condensed.num_threads=8
# condensed.sweep_mode=gauss_seidel
condensed.sweep_mode=colored
# condensed.true_schur=true        # not needed for the round cilia (stable without, ~4x faster)

###############################################
# Debug settings
###############################################
debug.pj=false
debug.rb=false