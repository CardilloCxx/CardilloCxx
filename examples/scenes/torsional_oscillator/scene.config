scene.name=torsional_oscillator

# Forced torsional oscillator on a revolute joint, see TorsionalOscillatorScene.hpp (closed-form
# solution; the bar rotates by more than 180 degrees). Checked by tests/test_torsional_oscillator.cpp.
sim.T=5.0
sim.dt=1e-3
sim.gravity=0 0 0

collision.disable_all=true

solver.name=moreau
solver.type=condensed
moreau.theta=0.6
condensed.true_schur=true

pj.max_iterations=10000
pj.tol_abs=1e-10
pj.tol_rel=1e-10

output.interval_steps=10
output.folder=./vtk_out
output.filename_prefix=torsional_oscillator
