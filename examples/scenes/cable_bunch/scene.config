scene.name = cable_bunch

###############################################
# Wilberforce Pendulum simulation settings
###############################################
sim.T=6.0              # total simulation time (seconds)
sim.dt=1e-3                # time step (seconds)
sim.gravity=0 0 -9.81      # gravity vector gx gy gz

###############################################
# Friction settings
###############################################
friction.enable=on
friction.combine=geom
friction.default_mu=0.05

###############################################
# Output settings
###############################################
output.interval_steps=20
output.folder = ./vtk_out
output.filename_prefix = cable_bunch

###############################################
# Collision settings
###############################################
collision.disable_all=false
collision.broadphase=dynamic_aabb
collision.match_max_dist=0.02
collision.security_margin=0.0000
collision.max_raw_contacts=300000
collision.max_patches=4
collision.use_patch_vertices=true
collision.min_pair_contact_distance=0.001

###############################################
# Projected Jacobi (normal contact) settings
###############################################
pj.max_iterations=10000
pj.tol_abs=1e-5
pj.tol_rel=1e-5
pj.relaxation=1.0
pj.alpha=0.4
pj.nesterov=true
pj.nesterov_beta_threshold=1.0
pj.nesterov_restart_limit=10000
pj.warmstart=true

###############################################
# Solver settings
###############################################
solver.name=moreau                     # time integrator: moreau
moreau.theta=0.6
moreau.implicit_gyroscopy=false

qoco.backend = cpu
solver.type= pj                     # solver for the inner loop: clarabel | projected_jacobi | qoco

solver.kkt_static_reg = 1e-5
solver.kkt_dynamic_reg = 1e-5
solver.iter_ref_iters = 0

###############################################
# Debug settings
###############################################
debug.pj=false
debug.rb=false
