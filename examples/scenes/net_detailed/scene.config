scene.name = net_detailed

###############################################
# Simulation settings
###############################################
sim.T=1.5          # total simulation time (seconds): 0.195 m pull at 0.5 m/s
sim.dt=1e-4        # time step (seconds)
sim.gravity=0 0 -9.81  # pull test in the x-y plane, gravity neglected

###############################################
# Friction settings
###############################################
friction.enable=on
friction.combine=geom         # min | arith | geom
friction.default_mu=0.2       # steel on steel (wires, clips, pins), assumed

###############################################
# Output settings
###############################################
output.interval_steps=25                  # write VTK every N steps
output.folder = ./vtk_out                # output directory path, also for <prefix>_force.csv
output.filename_prefix = net_detailed    # prefix for output files

###############################################
# Scene settings (defaults and references: NetDetailedScene.hpp)
###############################################
scene.primitive_colliders=0              # 1: capsule per wire segment, 0: inter-segment hull colliders
scene.ring_windings=12                   # ROCCO 12/3/300
scene.wire_diameter=0.003
scene.ring_inner_diameter=0.3
scene.wire_gap=1e-4                      # initial gap between the wires of a bundle (m)
scene.wire_segments=48                   # beam elements per wire loop
scene.link_slack=0.01                    # initial slack of the links (m)
scene.crossing_clearance=1.5             # initial gap of linked rings at the crossings (bundle diameters)
scene.pin_diameter=0.02
scene.pin_gap=0.002
scene.pull_speed=0.5                     # speed of the right block (m/s)
scene.pull_ramp=0.02                     # smooth start (s)
scene.clip_mode=3                        # 0: none, 1: pinned, 2: rigid, 3: pre-tensioned band
scene.clip_count=3
scene.clip_offset_deg=0
scene.band_thickness=0.0015              # clip band (clip_mode 3)
scene.band_width=0.015
scene.band_segments=12
scene.band_pretension=1e-3               # relative shortening of the band's rest length

###############################################
# Collision settings
###############################################
collision.broadphase=dynamic_aabb
collision.match_max_dist=0.002              # wires are 3 mm thick: match contacts within this distance (m)
collision.security_margin=0.0000
collision.max_raw_contacts=1000000
collision.max_patches=4
collision.use_patch_vertices=true
collision.min_pair_contact_distance=0.0005   # dedupe contacts of a pair closer than this (m)

###############################################
# Solver settings
###############################################
moreau.theta=1.0
moreau.implicit_gyroscopy=false

solver.name=moreau
solver.type=condensed
# solver.type=conicxx
# solver.type=clarabel
# solver.type=scs

pj.max_iterations=500000
pj.tol_abs=1e-4
pj.tol_rel=1e-4
# for conic solvers
# pj.tol_abs=1e-8
# pj.tol_rel=1e-8
pj.relaxation=1.0
pj.alpha=1.0
pj.nesterov=true
pj.nesterov_beta_threshold=1.0
pj.nesterov_restart_limit=10000
pj.warmstart=true

condensed.sweep_mode=colored          # gauss_seidel | colored
condensed.local_solve=projection      # projection | newton
condensed.num_threads=6               # 0 = OpenMP default (all available cores)
condensed.newton_max_iters=8
condensed.newton_tol=1e-10
condensed.projection_rho_strategy=split
condensed.true_schur=true

#################
# clarabel solver
#################

